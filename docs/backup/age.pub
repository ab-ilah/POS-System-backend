#
# Gabriel: replace the PLACEHOLDER line below with the one age1... recipient
# from a key generated on a trusted machine. Do not commit the private identity.
#
#   age-keygen -o pos-backup-identity.txt
#   age-keygen -y pos-backup-identity.txt
